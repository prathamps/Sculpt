# ----------------------------------------------------------------------------
# Sculpt MCP server — environment variables
# The MCP server lets AI assistants (Claude, ChatGPT, Cursor, VS Code, …) act
# in Sculpt on a person's behalf. It holds no data of its own: every action is
# a call to the Sculpt API with a token the person authorized.
# ----------------------------------------------------------------------------

PORT=3002

# Where this service reaches the Sculpt API. Inside Docker this is usually the
# internal address (http://api:3001), not the public one.
SCULPT_API_URL=http://localhost:3001

# The public issuer of Sculpt's OAuth tokens: the API's OAUTH_ISSUER, which
# defaults to its API_URL. Tokens whose "iss" differs are refused.
OAUTH_ISSUER=http://localhost:3001

# The public URL of this server's /mcp endpoint, exactly as AI clients reach
# it. It is the OAuth audience of every token this server accepts, so it must
# match MCP_RESOURCE_URL on the API. Required in production.
MCP_RESOURCE_URL=http://localhost:3002/mcp

# Shared secret that authenticates this service to the API when it exchanges
# a person's MCP token for a short-lived API token (RFC 8693). Use the same
# value as MCP_CLIENT_SECRET on the API. Required in production, at least 32
# characters: openssl rand -base64 48
MCP_CLIENT_SECRET=

# Used to build share links and to point people at the set-up guide.
FRONTEND_URL=http://localhost:3000

# Browser-based MCP clients send an Origin header; requests from any origin
# not listed here are refused, which stops DNS-rebinding attacks. The web app's
# origin and this server's own origin are always allowed, and so are loopback
# origins outside production (e.g. the MCP Inspector). Comma-separated; "*"
# turns the check off. Desktop and server-side clients send no Origin and are
# unaffected.
MCP_ALLOWED_ORIGINS=

# Largest file an assistant may upload through MCP (base64 inflates the
# request by about a third), and the largest image returned to the model.
MCP_MAX_UPLOAD_MB=20
MCP_MAX_IMAGE_MB=4

# Number of trusted proxy hops in front of this service, if any.
TRUST_PROXY=

# debug | info | warn | error
LOG_LEVEL=

# Lets assistants upload from sourceUrl addresses on private networks. Only
# for local development: it disables the SSRF guard.
MCP_ALLOW_PRIVATE_SOURCE_URLS=false

# --- Local stdio mode (npm run start:stdio) ---
# Runs the server over stdin/stdout for desktop clients, authenticated with a
# personal access token from Account → AI & integrations.
SCULPT_ACCESS_TOKEN=
