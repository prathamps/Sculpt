
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url        = env("DATABASE_URL")  
  directUrl  = env("DIRECT_URL")  
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectRole {
  OWNER
  MEMBER
  EDITOR
  VIEWER
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  MODEL
}

enum ProxyStatus {
  PENDING
  READY
  FAILED
}

enum ReviewStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  password      String?
  role          UserRole        @default(USER)
  provider      String?
  providerId    String?
  avatarUrl     String?
  tokenVersion  Int             @default(0)
  emailNotifications Boolean    @default(true)
  memberships   ProjectMember[]
  notifications Notification[]
  comments      Comment[]
  reviews       Review[]
  commentLikes  CommentLike[]
  commentMentions CommentMention[]
  auditLogs     AuditLog[]
  passwordResetTokens PasswordResetToken[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model PasswordResetToken {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RevokedSession {
  jti       String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Project {
  id         String          @id @default(cuid())
  name       String
  members    ProjectMember[]
  images     Image[]
  shareLinks ShareLink[]
  mediaAssets MediaAsset[]
  invitations ProjectInvitation[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model MediaAsset {
  storedPath String   @id
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model Image {
  id          String         @id @default(cuid())
  name        String
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions    ImageVersion[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId, updatedAt])
  @@index([projectId, name])
}

model ImageVersion {
  id          String    @id @default(cuid())
  url         String
  versionName String    @default("Version 1")
  versionNumber Int     @default(1)
  mediaType   MediaType @default(IMAGE)
  duration    Float?
  frameRate   Float?
  thumbnailUrl String?
  proxyUrl    String?
  proxyStatus ProxyStatus?
  proxyOwner  String?
  reviewStatus ReviewStatus @default(PENDING)
  dueAt       DateTime?
  imageId     String
  image       Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  comments    Comment[]
  reviews     Review[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([imageId, versionNumber])
  @@index([imageId])
  @@index([proxyStatus])
}

model Review {
  id             String         @id @default(cuid())
  imageVersionId String
  imageVersion   ImageVersion   @relation(fields: [imageVersionId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision       ReviewDecision
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([imageVersionId, userId])
  @@index([imageVersionId])
}

model Comment {
  id             String        @id @default(cuid())
  content        String
  imageVersionId String
  imageVersion   ImageVersion  @relation(fields: [imageVersionId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId       String?       @map("parent_id")
  parent         Comment?      @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]     @relation("CommentToComment")
  likes          CommentLike[]
  annotation     Json?
  timestamp      Float?
  timestampEnd   Float?
  page           Int?
  modelAnchor    Json?
  resolved       Boolean          @default(false)
  mentions       CommentMention[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([imageVersionId, createdAt])
  @@index([parentId])
  @@index([userId])
}

model CommentMention {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model Notification {
  id        String   @id @default(cuid())
  content   String
  read      Boolean  @default(false)
  metadata  Json?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model ShareLink {
  id        String      @id @default(cuid())
  token     String      @unique
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      ProjectRole
  expiresAt DateTime?
  maxUses   Int?
  useCount  Int         @default(0)
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([projectId])
}

model ProjectInvitation {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email       String
  role        ProjectRole
  tokenHash   String      @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@unique([projectId, email])
  @@index([email])
  @@index([expiresAt])
}
