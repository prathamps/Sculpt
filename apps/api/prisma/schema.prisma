
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url        = env("DATABASE_URL")  
  directUrl  = env("DIRECT_URL")  
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectRole {
  OWNER
  MEMBER
  EDITOR
  VIEWER
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  MODEL
}

enum ProxyStatus {
  PENDING
  READY
  FAILED
}

enum ReviewStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum RevisionCheckStatus {
  FIXED
  NOT_FIXED
}

enum MediaAssetKind {
  ORIGINAL
  PROXY
  THUMBNAIL
  ATTACHMENT
}

enum OAuthClientKind {
  DYNAMIC
  METADATA_DOCUMENT
  FIRST_PARTY
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  password      String?
  role          UserRole        @default(USER)
  provider      String?
  providerId    String?
  avatarUrl     String?
  tokenVersion  Int             @default(0)
  emailNotifications Boolean    @default(true)
  emailOnMention     Boolean    @default(true)
  emailOnComment     Boolean    @default(true)
  emailOnReply       Boolean    @default(true)
  emailOnReview      Boolean    @default(true)
  totpSecret         String?
  totpPendingSecret  String?
  totpEnabledAt      DateTime?
  totpLastStep       Int?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  mfaRecoveryCodes   MfaRecoveryCode[]
  memberships   ProjectMember[]
  notifications Notification[]
  comments      Comment[]
  reviews       Review[]
  revisionChecks RevisionCheck[]
  commentLikes  CommentLike[]
  commentMentions CommentMention[]
  passwordResetTokens PasswordResetToken[]
  oauthGrants   OAuthGrant[]
  personalAccessTokens PersonalAccessToken[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model PasswordResetToken {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RevokedSession {
  jti       String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  sequence   Int      @unique
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  prevHash   String?
  hash       String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

model Project {
  id         String          @id @default(cuid())
  name       String
  allowDownloads   Boolean   @default(true)
  watermarkViewers Boolean   @default(false)
  members    ProjectMember[]
  images     Image[]
  folders    Folder[]
  shareLinks ShareLink[]
  mediaAssets MediaAsset[]
  invitations ProjectInvitation[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderToFolder")
  images    Image[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, parentId, name])
  @@index([projectId, parentId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

model MediaAsset {
  storedPath String   @id
  kind       MediaAssetKind @default(ORIGINAL)
  imageVersionId String?
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([imageVersionId])
}

model Image {
  id          String         @id @default(cuid())
  name        String
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions    ImageVersion[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId, updatedAt])
  @@index([projectId, name])
  @@index([projectId, folderId, createdAt])
  @@index([folderId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ImageVersion {
  id          String    @id @default(cuid())
  url         String
  versionName String    @default("Version 1")
  versionNumber Int     @default(1)
  mediaType   MediaType @default(IMAGE)
  duration    Float?
  frameRate   Float?
  startTimecode String?
  thumbnailUrl String?
  proxyUrl    String?
  proxyLowUrl String?
  proxyStatus ProxyStatus?
  proxyOwner  String?
  reviewStatus ReviewStatus @default(PENDING)
  dueAt       DateTime?
  imageId     String
  image       Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  comments    Comment[]
  reviews     Review[]
  revisionChecks RevisionCheck[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([imageId, versionNumber])
  @@index([imageId])
  @@index([proxyStatus])
  @@index([versionName(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Review {
  id             String         @id @default(cuid())
  imageVersionId String
  imageVersion   ImageVersion   @relation(fields: [imageVersionId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  decision       ReviewDecision
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([imageVersionId, userId])
  @@index([imageVersionId])
}

model Comment {
  id             String        @id @default(cuid())
  content        String
  imageVersionId String
  imageVersion   ImageVersion  @relation(fields: [imageVersionId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId       String?       @map("parent_id")
  parent         Comment?      @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]     @relation("CommentToComment")
  likes          CommentLike[]
  annotation     Json?
  timestamp      Float?
  timestampEnd   Float?
  page           Int?
  modelAnchor    Json?
  resolved       Boolean          @default(false)
  internal       Boolean          @default(false)
  mentions       CommentMention[]
  attachments    CommentAttachment[]
  revisions      CommentRevision[]
  revisionChecks RevisionCheck[]
  editedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([imageVersionId, createdAt])
  @@index([parentId])
  @@index([userId])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
}

model RevisionCheck {
  id             String              @id @default(cuid())
  commentId      String
  comment        Comment             @relation(fields: [commentId], references: [id], onDelete: Cascade)
  imageVersionId String
  imageVersion   ImageVersion        @relation(fields: [imageVersionId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  status         RevisionCheckStatus
  resolvedComment Boolean            @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([commentId, imageVersionId])
  @@index([imageVersionId])
}

model CommentRevision {
  id          String   @id @default(cuid())
  commentId   String
  comment     Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  content     String
  editedById  String?
  createdAt   DateTime @default(now())

  @@index([commentId, createdAt])
}

model CommentAttachment {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  mimeType  String
  createdAt DateTime @default(now())

  @@index([commentId])
}

model CommentMention {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model Notification {
  id        String   @id @default(cuid())
  content   String
  read      Boolean  @default(false)
  metadata  Json?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
  @@index([createdAt])
}

model ShareLink {
  id        String      @id @default(cuid())
  tokenHash String      @unique
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      ProjectRole
  expiresAt DateTime?
  maxUses   Int?
  useCount  Int         @default(0)
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([projectId])
}

model ProjectInvitation {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email       String
  role        ProjectRole
  tokenHash   String      @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@unique([projectId, email])
  @@index([email])
  @@index([expiresAt])
}

model OAuthClient {
  id                      String          @id
  kind                    OAuthClientKind
  name                    String
  secretHash              String?
  redirectUris            String[]
  grantTypes              String[]
  tokenEndpointAuthMethod String
  scope                   String?
  clientUri               String?
  logoUri                 String?
  softwareId              String?
  softwareVersion         String?
  metadataExpiresAt       DateTime?
  verifiedAt              DateTime?
  disabledAt              DateTime?
  lastUsedAt              DateTime?
  grants                  OAuthGrant[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([kind, createdAt])
}

model OAuthGrant {
  id                 String                   @id @default(cuid())
  userId             String
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId           String
  client             OAuthClient              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopes             String[]
  requestedScopes    String[]                 @default([])
  resource           String
  tokenVersion       Int
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  authorizationCodes OAuthAuthorizationCode[]
  refreshTokens      OAuthRefreshToken[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([userId, revokedAt])
  @@index([clientId])
}

model OAuthAuthorizationCode {
  codeHash      String     @id
  grantId       String
  grant         OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scopes        String[]
  resource      String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime   @default(now())

  @@index([grantId])
  @@index([expiresAt])
}

model OAuthConsumedRequest {
  id        String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model OAuthRefreshToken {
  tokenHash String     @id
  grantId   String
  grant     OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  scopes    String[]
  resource  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([grantId])
  @@index([expiresAt])
}

model PersonalAccessToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  lastFour   String
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model OAuthSigningKey {
  kid        String    @id
  algorithm  String
  publicJwk  Json
  privateKey String
  retiredAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([retiredAt, createdAt])
}
