# ----------------------------------------------------------------------------
# Sculpt API — environment variables
# Copy to .env and fill in. Optional blocks can be left blank; the related
# feature simply stays disabled (the app still boots and the FREE tier works).
# ----------------------------------------------------------------------------

# --- Database (PostgreSQL, required) ---
DATABASE_URL=postgresql://user:password@localhost:5432/sculpt
DIRECT_URL=postgresql://user:password@localhost:5432/sculpt

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Auth (required) ---
JWT_SECRET=replace-with-a-long-random-secret

# URLs used for OAuth + Stripe redirects and OAuth callback construction.
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Redis (optional — graceful fallback if absent) ---
REDIS_URL=redis://localhost:6379

# --- OAuth (optional) — buttons appear only for configured providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# --- Billing provider ---
# The active provider is auto-detected: if RAZORPAY_* keys are present Razorpay
# is used; otherwise Stripe. Configure ONE of the two blocks below.

# --- Razorpay (India-friendly; recurring Subscriptions) ---
# Test mode: dashboard -> use rzp_test_ keys; create a Plan and copy its plan_id.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Billing cycles before the subscription completes (e.g. 12 months).
RAZORPAY_TOTAL_COUNT=12

# --- Stripe (optional alternative) — disabled until all three are set ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Email / SMTP (optional) — offline-member emails no-op if unset ---
# Works with any SMTP provider (Gmail app password, Mailtrap, Postmark, SES…).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sculpt <no-reply@sculpt.app>"

# --- Uploads ---
MAX_UPLOAD_MB=200
