# ----------------------------------------------------------------------------
# Sculpt API — environment variables
# Copy to .env and fill in. Optional blocks can be left blank; the related
# feature simply stays disabled (the app still boots without them).
# ----------------------------------------------------------------------------

# --- Database (PostgreSQL, required) ---
DATABASE_URL=postgresql://user:password@localhost:5432/sculpt
DIRECT_URL=postgresql://user:password@localhost:5432/sculpt

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Auth (required) ---
# With NODE_ENV=production the server REFUSES TO START unless this is set to
# something other than the placeholder and at least 32 characters long.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# URLs used for OAuth redirects, email links and CORS.
# FRONTEND_URL is required when NODE_ENV=production.
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- CORS ---
# Only FRONTEND_URL and API_URL hosts are allowed by default. localhost is
# additionally allowed outside production. To trust a preview platform's
# subdomains, list the apex domains here (comma-separated). Matching is
# anchored at a dot boundary, so "vercel.app" allows foo.vercel.app but never
# vercel.app.evil.com. Leave blank unless you actually deploy previews.
CORS_ALLOWED_HOST_SUFFIXES=

# --- Redis (optional — graceful fallback if absent) ---
# Required to run more than one API instance: it backs the Socket.IO adapter
# (so realtime events reach every replica), cross-instance presence, and
# shared rate-limit counters. Without it a single instance still works fully.
REDIS_URL=redis://localhost:6379

# --- Logging ---
# debug | info | warn | error. Defaults to debug outside production, info in
# production, where logs are emitted as one JSON object per line.
LOG_LEVEL=

# --- Proxy ---
# Set to the number of trusted proxy hops (e.g. 1 behind a single reverse
# proxy / load balancer) so req.ip and audit-logged IPs use X-Forwarded-For.
# Leave blank on a direct-facing deployment so the header can't be spoofed.
TRUST_PROXY=

# --- OAuth (optional) — buttons appear only for configured providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# --- Email / SMTP (optional) ---
# Without SMTP, email silently no-ops: offline-activity emails, project
# invitations for people who haven't signed up, and PASSWORD RESET links.
# Configure this if you want self-service password recovery to work.
# Works with any SMTP provider (Gmail app password, Mailtrap, Postmark, SES…).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sculpt <no-reply@sculpt.app>"

# --- Uploads ---
# Largest single file accepted, in MB. Keep NEXT_PUBLIC_MAX_UPLOAD_MB in
# apps/web in sync so the browser rejects oversized files before uploading.
# Budget disk accordingly: a video is staged, copied for transcoding, and
# stored alongside its proxy, so peak usage is several times the upload size.
MAX_UPLOAD_MB=2048

# --- Media workers ---
# How many ffmpeg jobs this instance runs at once. Video transcoding is CPU
# bound and shares the process with the HTTP server, so raising this trades
# API latency for throughput. Leave at the defaults unless you have cores to
# spare or run a dedicated instance for processing.
VIDEO_WORKER_CONCURRENCY=1
IMAGE_WORKER_CONCURRENCY=2

# Stable identifier for this instance. Crash recovery only fails transcode
# jobs it owns, so replicas never cancel each other's work. Leave blank to
# generate one per process (correct for single-instance deployments).
SCULPT_INSTANCE_ID=

# --- File storage (optional) ---
# Files are stored on the local disk under apps/api/uploads by default and are
# served through an authenticated route that checks project membership.
# Set S3_BUCKET to switch to any S3-compatible store (AWS S3, Cloudflare R2,
# MinIO). Credentials use the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# environment variables. S3_ENDPOINT is only needed for non-AWS providers, and
# S3_PUBLIC_URL overrides the public base URL (e.g. a CDN in front of the bucket).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Set to true to keep the bucket PRIVATE. Media is then served through the same
# authenticated route as local disk, which redirects to a short-lived presigned
# URL. Leave false only if you accept that anyone with an object URL can read
# your clients' media.
S3_PRIVATE=false
