# Sculpt web — environment variables
# Copy to .env.local and adjust if your API runs elsewhere.

# Base URL of the Sculpt API (REST endpoints).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Socket.IO server URL (usually the same as the API).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Largest file the API will accept, in MB. Must match MAX_UPLOAD_MB in apps/api
# so the browser rejects oversized files before uploading them.
NEXT_PUBLIC_MAX_UPLOAD_MB=200
