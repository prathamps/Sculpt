{
	email {$TLS_EMAIL}
}

{$SCULPT_DOMAIN} {
	encode zstd gzip

	handle_path /api-origin/* {
		reverse_proxy api:3001
	}

	handle /socket.io/* {
		reverse_proxy api:3001
	}

	handle /uploads/* {
		reverse_proxy api:3001
	}

	handle /health {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	request_body {
		max_size 2GB
	}
}
