{
	email {$TLS_EMAIL}
}

{$SCULPT_DOMAIN} {
	encode zstd gzip

	handle_path /api-origin/* {
		reverse_proxy api:3001
	}

	handle /socket.io/* {
		reverse_proxy api:3001
	}

	handle /uploads/* {
		reverse_proxy api:3001
	}

	handle /health {
		reverse_proxy api:3001
	}

	@oauth path /oauth/authorize /oauth/token /oauth/register /oauth/revoke /oauth/introspect /oauth/jwks.json /.well-known/oauth-authorization-server
	handle @oauth {
		reverse_proxy api:3001
	}

	@mcp path /mcp /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @mcp {
		reverse_proxy mcp:3002 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	request_body {
		max_size 2GB
	}
}
